{
  "name": "marble-works",
  "productName": "Marble Works",
  "version": "1.0.0",
  "description": "Sort glowing marbles into the right cups. A puzzle game for ages 5 to 11.",
  "author": "Kai",
  "main": "main.js",
  "private": true,
  "scripts": {
    "copy-web": "node -e \"const fs=require('fs');fs.rmSync('app',{recursive:true,force:true});fs.cpSync('../web','app',{recursive:true,filter:s=>!s.endsWith('sw.js')})\"",
    "start": "npm run copy-web && electron .",
    "dist": "npm run copy-web && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.asmo7791.marbleworks",
    "productName": "Marble Works",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "app/icons/icon-1024.png",
    "artifactName": "Marble-Works-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.puzzle-games",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "publish": null
  },
  "repository": "https://github.com/Asmo7791/marble-works",
  "license": "MIT",
  "homepage": "https://asmo7791.github.io/marble-works/"
}
